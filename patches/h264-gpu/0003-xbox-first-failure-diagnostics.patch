From 2caf608f6518b8a66986b57bfa0dd8974ce66165 Mon Sep 17 00:00:00 2001
From: IamArchUserBtw <a_ajbar@live.concordia.ca>
Date: Sat, 5 Sep 2026 08:15:13 -0400
Subject: [PATCH] experiment: stop repeated GPU fallback and diagnose first
 Xbox failure

---
 experiments/h264_gpu/README.md        | 11 +++++++
 experiments/h264_gpu/ffmpeg_bridge.c  |  2 +-
 experiments/h264_gpu/xdk_backend.cpp  | 26 ++++++++++++++--
 experiments/h264_gpu/xdk_backend.h    |  5 +++
 experiments/h264_gpu/xdk_validate.cpp | 44 +++++++++++++++++++++++++--
 5 files changed, 82 insertions(+), 6 deletions(-)

diff --git a/experiments/h264_gpu/README.md b/experiments/h264_gpu/README.md
index e1d9d11..7daee5f 100644
--- a/experiments/h264_gpu/README.md
+++ b/experiments/h264_gpu/README.md
@@ -74,3 +74,14 @@ Windows WARP pass is not Xbox validation. The runner compares single-thread
 CPU/hybrid timings; production decisions additionally need the current app's
 thread configuration, varied real streams, latency distributions and sustained
 thermal/network workloads. A pixel pass alone does not meet that gate.
+
+Validation v2 performs constant and fractional-motion GPU smoke tests before
+decoding a fixture, flushes diagnostic log lines immediately, and stops at the
+first backend failure. The first GPU batch logs raw float values and bits
+after both transform passes and output resolve. Explicit resource waits
+precede CPU inspection. These diagnostic waits make v2 unsuitable for speed
+claims. Blue indicates execution; red means failure and green means success.
+The test requests a dashboard launch after cleanup. After a backend failure,
+later macroblocks use the original FFmpeg decoder instead of repeatedly
+entering emergency replay. These changes require another Xbox run; they do
+not establish the cause of the first run's invalid output or reported crash.
diff --git a/experiments/h264_gpu/ffmpeg_bridge.c b/experiments/h264_gpu/ffmpeg_bridge.c
index 11c2601..9761c0a 100644
--- a/experiments/h264_gpu/ffmpeg_bridge.c
+++ b/experiments/h264_gpu/ffmpeg_bridge.c
@@ -19,7 +19,7 @@ int ff_xenon_h264_submit(H264Context* h){
     Picture* ref;
     int plane,block,x,y,index;
     DECLARE_ALIGNED(16,int16_t,coeff)[768];
-    if(!b)return 0;
+    if(!b||b->backend_failures)return 0;
     /* No approximation: every unsupported MB executes the original decoder
        after pending GPU pixels have been returned to CPU memory. */
     if(h->pixel_shift||h->sps.chroma_format_idc!=1||FRAME_MBAFF||FIELD_PICTURE||
diff --git a/experiments/h264_gpu/xdk_backend.cpp b/experiments/h264_gpu/xdk_backend.cpp
index 2152578..1796409 100644
--- a/experiments/h264_gpu/xdk_backend.cpp
+++ b/experiments/h264_gpu/xdk_backend.cpp
@@ -3,6 +3,7 @@
 #include <cstdio>
 #include <cstring>
 #include <vector>
+#include <cstdarg>
 
 namespace {
 template<class T>void release(T*& p){if(p){p->Release();p=NULL;}}
@@ -32,12 +33,26 @@ struct Scene {IDirect3DDevice9* d;Scene(IDirect3DDevice9* device):d(device){d->B
 }
 XenonGpuReconstructor::XenonGpuReconstructor(IDirect3DDevice9* d):elapsed_ticks(0),upload_ticks(0),readback_ticks(0),successful_batches(0),
     device_(d),vertex_(NULL),declaration_(NULL),columns_(NULL),rows_(NULL),luma_(NULL),chroma_(NULL),
-    coefficients_(NULL),intermediate_(NULL),residual_(NULL),output_(NULL),target_(NULL),reference_cursor_(0),ready_(false){if(d)d->AddRef();}
+    coefficients_(NULL),intermediate_(NULL),residual_(NULL),output_(NULL),target_(NULL),reference_cursor_(0),ready_(false),log_(NULL){if(d)d->AddRef();}
+void XenonGpuReconstructor::trace(const char* format,...){
+    if(!log_)return;va_list args;va_start(args,format);vfprintf(log_,format,args);va_end(args);fflush(log_);
+}
+void XenonGpuReconstructor::inspect(const char* stage,IDirect3DTexture9* texture){
+    if(!log_||successful_batches)return;
+    trace("GPU checkpoint %s wait\n",stage);
+    texture->BlockUntilNotBusy();D3DLOCKED_RECT locked;
+    if(FAILED(texture->LockRect(0,&locked,NULL,D3DLOCK_READONLY))){trace("FAIL checkpoint lock %s\n",stage);return;}
+    trace("GPU checkpoint %s pitch=%d",stage,locked.Pitch);
+    for(int i=0;i<8;++i){float v=((const float*)locked.pBits)[i];unsigned bits;memcpy(&bits,&v,4);trace(" %g/%08x",v,bits);}
+    trace("\n");texture->UnlockRect(0);
+}
 XenonGpuReconstructor::~XenonGpuReconstructor(){
+    trace("GPU cleanup begin\n");
     if(device_)device_->BlockUntilIdle();
     for(int i=0;i<16;++i)release(refs_[i].texture);
     release(target_);release(coefficients_);release(intermediate_);release(residual_);release(output_);
     release(vertex_);release(declaration_);release(columns_);release(rows_);release(luma_);release(chroma_);release(device_);
+    trace("GPU cleanup complete\n");
 }
 bool XenonGpuReconstructor::initialize(const char* path){
     if(!device_||ready_)return false;
@@ -112,8 +127,10 @@ bool XenonGpuReconstructor::execute(const XenonH264Job* jobs,unsigned count){
         coefficients_->UnlockRect(0);upload_ticks+=ticks()-start;
         device_->SetTexture(0,NULL);device_->SetTexture(2,coefficients_);
         if(!draw(columns_,full,6,intermediate_))return false;
+        inspect("columns",intermediate_);
         device_->SetTexture(2,intermediate_);
         if(!draw(rows_,full,6,residual_))return false;
+        inspect("residual",residual_);
         device_->SetTexture(2,residual_);
         // Group independent output quads by reference; one draw per group.
         bool done[XENON_H264_BATCH_MAX]={};
@@ -134,11 +151,16 @@ bool XenonGpuReconstructor::execute(const XenonH264Job* jobs,unsigned count){
         device_->SetTexture(0,NULL);device_->SetTexture(2,NULL);
         device_->Resolve(D3DRESOLVE_RENDERTARGET0,NULL,output_,NULL,0,0,NULL,1,0,NULL);
         start=ticks();
+        // Resolve writes must be complete before dereferencing CPU memory.
+        output_->BlockUntilNotBusy();
+        inspect("output",output_);
         if(FAILED(output_->LockRect(0,&lock,NULL,D3DLOCK_READONLY)))return false;
         bool valid=true;
         for(unsigned i=0;i<count;++i)for(int y=0;y<side;++y){const float* row=(const float*)((const uint8_t*)lock.pBits+y*lock.Pitch)+i*side;
             uint8_t* dst=jobs[i].destination[plane]+y*jobs[i].destination_stride[plane];
-            for(int x=0;x<side;++x){const float v=row[x];if(!(v>=0&&v<=255)||(float)(int)v!=v){valid=false;break;}dst[x]=(uint8_t)v;}}
+            for(int x=0;x<side;++x){const float v=row[x];if(!(v>=0&&v<=255)||(float)(int)v!=v){
+                if(valid){unsigned bits;memcpy(&bits,&v,4);trace("FAIL GPU output plane=%d job=%u x=%d y=%d value=%g bits=%08x pitch=%d\n",plane,i,x,y,v,bits,lock.Pitch);}
+                valid=false;break;}dst[x]=(uint8_t)v;}}
         output_->UnlockRect(0);readback_ticks+=ticks()-start;
         if(!valid){ready_=false;return false;}
     }
diff --git a/experiments/h264_gpu/xdk_backend.h b/experiments/h264_gpu/xdk_backend.h
