diff --git a/experiments/h264_gpu/xdk_validate.cpp b/experiments/h264_gpu/xdk_validate.cpp
index e2352c5..c3f1973 100644
--- a/experiments/h264_gpu/xdk_validate.cpp
+++ b/experiments/h264_gpu/xdk_validate.cpp
@@ -16,6 +16,28 @@ extern AVCodecParser ff_h264_parser;
 namespace {
 FILE* log_file=NULL;
 uint64_t tick(){LARGE_INTEGER t;QueryPerformanceCounter(&t);return(uint64_t)t.QuadPart;}
+void status(IDirect3DDevice9* device,D3DCOLOR color){
+    device->Clear(0,NULL,D3DCLEAR_TARGET,color,1,0);device->Present(NULL,NULL,NULL,NULL);
+}
+bool smoke_test(XenonGpuReconstructor& backend){
+    XenonH264Backend callback=backend.callbacks();
+    for(int pass=0;pass<2;++pass){
+        uint8_t reference[3][1024],actual[3][256],expected[3][256];XenonH264Job j;memset(&j,0,sizeof(j));
+        memset(actual,0xa5,sizeof(actual));memset(expected,0xa5,sizeof(expected));
+        j.width=j.height=32;j.mv_x=pass?-3:0;j.mv_y=pass?5:0;
+        for(int p=0;p<3;++p){for(int i=0;i<1024;++i)reference[p][i]=pass?(uint8_t)(i*37+p*53):127;
+            j.reference[p]=reference[p];j.reference_stride[p]=32;j.destination[p]=expected[p];j.destination_stride[p]=16;}
+        if(pass)for(int i=0;i<384;++i)j.coefficients[i]=(int16_t)((i*13)%127-63);
+        xenon_h264_reconstruct_cpu(&j);
+        for(int p=0;p<3;++p)j.destination[p]=actual[p];
+        callback.begin_picture(callback.opaque,-2+pass);
+        fprintf(log_file,"GPU smoke begin pass=%d\n",pass);
+        if(!callback.execute(callback.opaque,&j,1)){fprintf(log_file,"FAIL GPU smoke backend pass=%d\n",pass);return false;}
+        for(int p=0;p<3;++p)for(int i=0;i<256;++i)if(actual[p][i]!=expected[p][i]){
+            fprintf(log_file,"FAIL GPU smoke pixel pass=%d plane=%d offset=%d expected=%u actual=%u\n",pass,p,i,expected[p][i],actual[p][i]);return false;}
+        fprintf(log_file,"PASS GPU smoke pass=%d\n",pass);
+    }return true;
+}
 bool same_frame(const AVFrame* a,const AVFrame* b){
     if(a->width!=b->width||a->height!=b->height||a->format!=b->format)return false;
     if(a->format!=AV_PIX_FMT_YUV420P&&a->format!=AV_PIX_FMT_YUVJ420P)return false;
@@ -33,23 +55,29 @@ bool packet(AVCodecContext* cpu,AVCodecContext* gpu,AVFrame* a,AVFrame* b,uint8_
     AVPacket p;av_init_packet(&p);p.data=data;p.size=size;int have_a=0,have_b=0;
     uint64_t begin=tick();int rc_a=avcodec_decode_video2(cpu,a,&have_a,&p);cpu_ticks+=tick()-begin;
     begin=tick();int rc_b=avcodec_decode_video2(gpu,b,&have_b,&p);gpu_ticks+=tick()-begin;
+    XenonH264Bridge* bridge=(XenonH264Bridge*)gpu->opaque;
+    if(bridge&&bridge->backend_failures){fprintf(log_file,"FAIL first GPU backend failure; stopping at frame=%u\n",frames);return false;}
     if(rc_a<0||rc_b<0||have_a!=have_b){fprintf(log_file,"FAIL decode cpu=%d gpu=%d output=%d/%d\n",rc_a,rc_b,have_a,have_b);return false;}
     if(have_a){++frames;if(!same_frame(a,b)){fprintf(log_file,"FAIL pixels frame=%u\n",frames);return false;}}
     return true;
 }
 }
-int main(){
+int run_validation(){
     log_file=fopen("game:\\gpu-validation.log","wb");if(!log_file)return 1;
-    fprintf(log_file,"GPU H264 standalone validation; full CPU intra/deblocking, bounded GPU inter batches\n");fflush(log_file);
+    setvbuf(log_file,NULL,_IONBF,0);
+    fprintf(log_file,"GPU H264 validation v2; first-failure diagnostics, smoke test, explicit dashboard exit\n");
     IDirect3D9* api=Direct3DCreate9(D3D_SDK_VERSION);IDirect3DDevice9* device=NULL;
     D3DPRESENT_PARAMETERS pp;memset(&pp,0,sizeof(pp));pp.BackBufferWidth=1280;pp.BackBufferHeight=720;
     pp.BackBufferFormat=D3DFMT_A8R8G8B8;pp.FrontBufferFormat=D3DFMT_LE_X8R8G8B8;
     pp.BackBufferCount=1;pp.MultiSampleType=D3DMULTISAMPLE_NONE;pp.SwapEffect=D3DSWAPEFFECT_DISCARD;pp.PresentationInterval=D3DPRESENT_INTERVAL_IMMEDIATE;
     if(!api||FAILED(api->CreateDevice(0,D3DDEVTYPE_HAL,NULL,D3DCREATE_HARDWARE_VERTEXPROCESSING,&pp,&device))){fprintf(log_file,"FAIL device\n");fclose(log_file);if(api)api->Release();return 1;}
+    status(device,D3DCOLOR_XRGB(0,40,100));fprintf(log_file,"Device initialized\n");
     int result=1;
     {
         XenonGpuReconstructor backend(device);
+        backend.set_log(log_file);
         if(!backend.initialize("game:")){fprintf(log_file,"FAIL shader/texture/target initialization\n");}
+        else if(!smoke_test(backend)){fprintf(log_file,"FAIL smoke test; fixture decoding skipped\n");}
         else {
             FILE* file=fopen("game:\\gpu-fixture.h264","rb");
             if(!file)fprintf(log_file,"FAIL missing gpu-fixture.h264\n");
@@ -91,5 +119,15 @@ int main(){
             }
         }
     }
-    device->Release();api->Release();fclose(log_file);return result;
+    fprintf(log_file,"Validation finished result=%d\n",result);
+    status(device,result?D3DCOLOR_XRGB(150,0,0):D3DCOLOR_XRGB(0,130,0));Sleep(3000);
+    fprintf(log_file,"Device cleanup begin\n");device->Release();api->Release();
+    fprintf(log_file,"Device cleanup complete\n");fclose(log_file);log_file=NULL;return result;
+}
+int main(){
+    int result=run_validation();
+    FILE* end=fopen("game:\\gpu-validation.log","ab");
+    if(end){fprintf(end,"Dashboard launch requested result=%d\n",result);fclose(end);}
+    XLaunchNewImage("",0);
+    return result;
 }
