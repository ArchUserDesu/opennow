new file mode 100644
index 0000000..e76fcdd
--- /dev/null
+++ b/experiments/h264_gpu/validation_log.cpp
@@ -0,0 +1,27 @@
+#include <xtl.h>
+#include <cstdio>
+#include <cstdarg>
+#include <cstring>
+#include "validation_log.h"
+namespace { HANDLE log_handle=INVALID_HANDLE_VALUE; }
+bool gpu_log_open(){
+    log_handle=CreateFileA("game:\\gpu-validation.log",GENERIC_WRITE,FILE_SHARE_READ,NULL,
+                          CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL|FILE_FLAG_WRITE_THROUGH,NULL);
+    return log_handle!=INVALID_HANDLE_VALUE;
+}
+void gpu_log(const char* format,...){
+    char buffer[2048];va_list args;va_start(args,format);
+    _vsnprintf(buffer,sizeof(buffer)-1,format,args);va_end(args);buffer[sizeof(buffer)-1]=0;
+    OutputDebugStringA(buffer);
+    if(log_handle==INVALID_HANDLE_VALUE)return;
+    DWORD length=(DWORD)strlen(buffer),offset=0;
+    while(offset<length){DWORD written=0;
+        if(!WriteFile(log_handle,buffer+offset,length-offset,&written,NULL)||!written){
+            OutputDebugStringA("GPU diagnostic log write failed\n");return;}
+        offset+=written;
+    }
+    if(!FlushFileBuffers(log_handle))OutputDebugStringA("GPU diagnostic log flush failed\n");
+}
+void gpu_log_close(){
+    if(log_handle!=INVALID_HANDLE_VALUE){FlushFileBuffers(log_handle);CloseHandle(log_handle);log_handle=INVALID_HANDLE_VALUE;}
+}
