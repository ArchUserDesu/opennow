index 0000000..07cb926
--- /dev/null
+++ b/experiments/h264_gpu/build_xdk.ps1
@@ -0,0 +1,42 @@
+param([Parameter(Mandatory=$true)][string]$Repo,[string]$XdkRoot='C:\Program Files (x86)\Microsoft Xbox 360 SDK')
+$ErrorActionPreference='Stop'
+$lab=(Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
+$repoPath=(Resolve-Path $Repo).Path
+$ff=Join-Path $repoPath 'xdk\deps-src\xbmc360\libraries\ffmpeg'
+$out=Join-Path $PSScriptRoot 'build'
+New-Item -ItemType Directory -Force $out | Out-Null
+$env:PATH=(Join-Path $XdkRoot 'bin\win32')+';'+$env:PATH
+$env:INCLUDE=(Join-Path $XdkRoot 'include\xbox')+';'+(Join-Path $XdkRoot 'include\xbox\sys')
+$env:LIB=(Join-Path $XdkRoot 'lib\xbox')
+$cl=Join-Path $XdkRoot 'bin\win32\cl.exe'
+function Checked([string]$exe,[string[]]$arguments){
+    $saved=$ErrorActionPreference;$ErrorActionPreference='Continue'
+    & $exe @arguments 2>&1 | ForEach-Object {Write-Output "$_"}
+    $rc=$LASTEXITCODE;$ErrorActionPreference=$saved
+    if($rc -ne 0){throw "Tool failed ($rc): $exe"}
+}
+$common=@('/nologo','/c','/O2','/Oi','/MT','/GS-','/W3','/D_XBOX','/DWIN32','/DHAVE_AV_CONFIG_H','/DOPENNOW_GPU_RECON_EXPERIMENT',"/I$ff",("/I"+(Join-Path $ff 'vcproj\external\include')),"/I$PSScriptRoot")
+$common+=("/I"+(Join-Path $ff 'libavcodec'))
+$sources=@(
+    @{Path=(Join-Path $lab 'xdk\deps-src\xbmc360\libraries\ffmpeg\libavcodec\h264.c');Name='h264_gpu';C=$true},
+    @{Path=(Join-Path $PSScriptRoot 'ffmpeg_bridge.c');Name='ffmpeg_bridge';C=$true},
+    @{Path=(Join-Path $PSScriptRoot 'hybrid_jobs.cpp');Name='hybrid_jobs';C=$false},
+    @{Path=(Join-Path $PSScriptRoot 'xdk_backend.cpp');Name='xdk_backend';C=$false},
+    @{Path=(Join-Path $PSScriptRoot 'xdk_validate.cpp');Name='xdk_validate';C=$false})
+$objects=@()
+foreach($source in $sources){
+    $obj=Join-Path $out ($source.Name+'.obj');$args=$common
+    if($source.C){$args+=@('/TC','/FIlibavutil/intmath.h','/FIconfig.h')}
+    else{$args+=@('/EHsc')}
+    Checked $cl ($args+@("/Fo$obj",$source.Path));$objects+=$obj
+}
+$pe=Join-Path $out 'gpu_validate.pe'
+$link=@('/nologo','/XEX:NO',"/OUT:$pe",("/PDB:"+(Join-Path $out 'gpu_validate.xdb')))
+$link+=$objects
+$link+=("/LIBPATH:"+(Join-Path $repoPath 'xdk\lib\Release'))
+$link+=@('libavcodec.lib','libavutil.lib','pthreads.lib','d3d9.lib','d3dx9.lib','xgraphics.lib','xapilib.lib','xmcore.lib','xbdm.lib','xboxkrnl.lib','xnet.lib')
+Checked (Join-Path $XdkRoot 'bin\win32\link.exe') $link
+$config=Join-Path $out 'gpu_validate.xml'
+'<?xml version="1.0"?><xex><titleid id="0x4F4E0002"/><privilege id="0"/></xex>' | Set-Content -Encoding ASCII $config
+Checked (Join-Path $XdkRoot 'bin\win32\imagexex.exe') @("/IN:$pe",("/OUT:"+(Join-Path $out 'gpu_validate.xex')),"/CONFIG:$config")
+Write-Output 'Built isolated gpu_validate.xex. No production build or remote deployment performed.'
diff --git a/experiments/h264_gpu/ffmpeg_bridge.c b/experiments/h264_gpu/ffmpeg_bridge.c
new file mode 100644
index 0000000..11c2601
--- /dev/null
+++ b/experiments/h264_gpu/ffmpeg_bridge.c
@@ -0,0 +1,74 @@
+/* Experimental private bridge to the pinned FFmpeg 1.2 H264Context.
+ * Compile only in the isolated GPU build. CPU fallback retains all syntax
+ * outside the deliberately narrow accelerated macroblock subset. */
+#include "libavcodec/h264.h"
+#include "hybrid_jobs.h"
+#include <string.h>
+
+static XenonH264Bridge* bridge_for(H264Context* h){
+    XenonH264Bridge* b=(XenonH264Bridge*)h->avctx->opaque;
+    if(!b||b->magic!=0x58483236||h->avctx->thread_count>1)return NULL;
+    return b;
+}
+void ff_xenon_h264_barrier(H264Context* h){xenon_h264_bridge_flush(bridge_for(h));}
+
+int ff_xenon_h264_submit(H264Context* h){
+    XenonH264Bridge* b=bridge_for(h);
+    const int mb_type=h->cur_pic.f.mb_type[h->mb_xy];
+    XenonH264Job* j;
+    Picture* ref;
+    int plane,block,x,y,index;
+    DECLARE_ALIGNED(16,int16_t,coeff)[768];
+    if(!b)return 0;
+    /* No approximation: every unsupported MB executes the original decoder
+       after pending GPU pixels have been returned to CPU memory. */
+    if(h->pixel_shift||h->sps.chroma_format_idc!=1||FRAME_MBAFF||FIELD_PICTURE||
+       h->is_complex||h->qscale==0||h->use_weight||!IS_INTER(mb_type)||
+       !IS_16X16(mb_type)||IS_8x8DCT(mb_type)||!IS_DIR(mb_type,0,0)||IS_DIR(mb_type,0,1)||
+       h->mb_width*16>XENON_H264_WIDTH_MAX||h->mb_height*16>720||h->avctx->codec_id!=AV_CODEC_ID_H264)return 0;
+    index=h->ref_cache[0][scan8[0]];
+    if(index<0||index>=h->ref_count[0])return 0;
+    ref=&h->ref_list[0][index];
+    if(!ref->f.data[0]||!ref->f.data[1]||!ref->f.data[2])return 0;
+    if(!b->have_picture||b->picture_number!=h->cur_pic.f.coded_picture_number){
+        xenon_h264_bridge_flush(b);
+        b->picture_number=h->cur_pic.f.coded_picture_number;b->have_picture=1;
+        if(b->backend.begin_picture)b->backend.begin_picture(b->backend.opaque,b->picture_number);
+    }
+    if(b->count==XENON_H264_BATCH_MAX)xenon_h264_bridge_flush(b);
+    j=&b->jobs[b->count];memset(j,0,sizeof(*j));
+    j->width=h->mb_width*16;j->height=h->mb_height*16;
+    j->mb_x=h->mb_x;j->mb_y=h->mb_y;
+    j->mv_x=h->mv_cache[0][scan8[0]][0];j->mv_y=h->mv_cache[0][scan8[0]][1];
+    memcpy(coeff,h->mb,sizeof(coeff));
+    if(h->cbp&0x30){
+        if(h->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(coeff+256,h->dequant4_coeff[4][h->chroma_qp[0]][0]);
+        if(h->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX+1]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(coeff+512,h->dequant4_coeff[5][h->chroma_qp[1]][0]);
+    }
+    for(plane=0;plane<3;++plane){
+        const int side=plane?8:16;
+        const int stride=plane?h->uvlinesize:h->linesize;
+        int16_t* output=j->coefficients+(plane?256+(plane-1)*64:0);
+        j->reference[plane]=ref->f.data[plane];j->reference_stride[plane]=ref->f.linesize[plane];
+        j->destination_stride[plane]=stride;
+        j->destination[plane]=h->cur_pic.f.data[plane]+h->mb_y*side*stride+h->mb_x*side;
+        for(block=0;block<(plane?4:16);++block){
+            const int source_block=plane*16+block;
+            const int cache=scan8[source_block];
+            const int block_x=plane?(block&1)*4:((scan8[block]-scan8[0])&7)*4;
+            const int block_y=plane?(block>>1)*4:((scan8[block]-scan8[0])>>3)*4;
+            const int coded=plane?(h->cbp&0x30)&&(h->non_zero_count_cache[cache]||coeff[source_block*16]):
+                                  (h->cbp&15)&&h->non_zero_count_cache[cache];
+            /* FFmpeg's DC-only fast path adds rounding in int32, whereas
+               its generic transform stores the rounded DC in int16. */
+            if(coded&&h->non_zero_count_cache[cache]<=1&&coeff[source_block*16]>32735)return 0;
+            if(coded)for(y=0;y<4;++y)for(x=0;x<4;++x)
+                output[(block_y+y)*side+block_x+x]=coeff[source_block*16+y*4+x];
+        }
+    }
+    h->list_counts[h->mb_xy]=h->list_count;
+    memset(h->mb,0,sizeof(h->mb));
+    ++b->count;return 1;
+}
diff --git a/experiments/h264_gpu/generate_fixtures.py b/experiments/h264_gpu/generate_fixtures.py
new file mode 100644
index 0000000..f12fa09
--- /dev/null
+++ b/experiments/h264_gpu/generate_fixtures.py
@@ -0,0 +1,31 @@
+"""Generate deterministic local fixtures; never contacts the Xbox."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parent
+sys.path.insert(0, str(root / "build" / "tools"))
+import imageio_ffmpeg
+
+ffmpeg = imageio_ffmpeg.get_ffmpeg_exe()
+out = root / "build"
+out.mkdir(exist_ok=True)
+manifest = {"encoder": subprocess.check_output([ffmpeg, "-version"], text=True).splitlines()[0], "fixtures": []}
+for name, options in [
+    ("gpu-fixture.h264", "partitions=none:8x8dct=0:weightp=0:bframes=0:ref=4"),
+    ("gpu-fixture-mixed.h264", "partitions=all:8x8dct=1:weightp=0:bframes=2:ref=4"),
+]:
+    path = out / name
+    args = [ffmpeg, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi", "-i",
+            "testsrc2=size=1280x720:rate=60", "-frames:v", "180", "-an", "-pix_fmt", "yuv420p",
+            "-c:v", "libx264", "-threads", "1", "-preset", "fast", "-crf", "22",
+            "-x264-params", options + ":keyint=60:min-keyint=60:scenecut=0", "-f", "h264", str(path)]
+    subprocess.run(args, check=True)
+    data = path.read_bytes()
+    assert 0 < len(data) <= 16 * 1024 * 1024
+    manifest["fixtures"].append({"file": name, "sha256": hashlib.sha256(data).hexdigest(),
+                                 "bytes": len(data), "frames": 180, "options": options})
+(out / "fixtures.json").write_text(json.dumps(manifest, indent=2) + "\n")
+print(json.dumps(manifest, indent=2))
diff --git a/experiments/h264_gpu/host_jobs_test.cpp b/experiments/h264_gpu/host_jobs_test.cpp
new file mode 100644
index 0000000..2f2651b
--- /dev/null
+++ b/experiments/h264_gpu/host_jobs_test.cpp
@@ -0,0 +1,59 @@
+// Exact replay tests against the pinned FFmpeg oracle. Host only.
+#include "hybrid_jobs.h"
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+extern "C" void oracle_qpel(unsigned char*,unsigned char*,int,int,int);
+extern "C" void oracle_idct4(unsigned char*,short*,int);
+static unsigned seed=71231;
+static unsigned random32(){seed=seed*1664525u+1013904223u;return seed;}
+static int clamp(int n,int hi){return n<0?0:n>hi?hi:n;}
+static int divfloor(int n,int d){return n>=0?n/d:-((-n+d-1)/d);}
+static int fail_after_write(void*,const XenonH264Job* j,unsigned n){
+    for(unsigned i=0;i<n;++i)memset(j[i].destination[0],0xee,16);return 0;
+}
+int main(){
+    unsigned long long checked=0;
+    static XenonH264Bridge bridge;
+    for(int test=0;test<2048;++test){
+        unsigned char ref[3][32*32],actual[3][32*32],expected[3][32*32];
+        XenonH264Job j={};j.width=j.height=32;j.mb_x=(test>>2)&1;j.mb_y=(test>>3)&1;
+        j.mv_x=(int)(random32()%97)-48;j.mv_y=(int)(random32()%97)-48;
+        memset(actual,0xa5,sizeof(actual));memset(expected,0xa5,sizeof(expected));
+        for(int p=0;p<3;++p){
+            const int side=p?8:16,w=p?16:32,unit=p?8:4;
+            for(int i=0;i<32*32;++i)ref[p][i]=(unsigned char)(random32()>>24);
+            j.reference[p]=ref[p];j.reference_stride[p]=32;j.destination[p]=actual[p];j.destination_stride[p]=32;
+            const int dx=divfloor(j.mv_x,unit),dy=divfloor(j.mv_y,unit),fx=j.mv_x-dx*unit,fy=j.mv_y-dy*unit;
+            if(!p){
+                unsigned char padded[64*64],result[64*64]={};
+                for(int y=0;y<64;++y)for(int x=0;x<64;++x)
+                    padded[y*64+x]=ref[p][clamp(j.mb_y*side+dy+y-16,w-1)*32+clamp(j.mb_x*side+dx+x-16,w-1)];
+                for(int y=0;y<side;y+=4)for(int x=0;x<side;x+=4)
+                    oracle_qpel(result+y*64+x,padded+(16+y)*64+16+x,64,fx,fy);
+                for(int y=0;y<side;++y)memcpy(expected[p]+y*32,result+y*64,side);
+            }else for(int y=0;y<side;++y)for(int x=0;x<side;++x){
+                int sx=j.mb_x*side+dx+x,sy=j.mb_y*side+dy+y;
+                int a=ref[p][clamp(sy,w-1)*32+clamp(sx,w-1)],b=ref[p][clamp(sy,w-1)*32+clamp(sx+1,w-1)];
+                int c=ref[p][clamp(sy+1,w-1)*32+clamp(sx,w-1)],d=ref[p][clamp(sy+1,w-1)*32+clamp(sx+1,w-1)];
+                expected[p][y*32+x]=(unsigned char)(((8-fx)*(8-fy)*a+fx*(8-fy)*b+(8-fx)*fy*c+fx*fy*d+32)/64);
+            }
+            short* atlas=j.coefficients+(p?256+(p-1)*64:0);
+            for(int by=0;by<side;by+=4)for(int bx=0;bx<side;bx+=4){short coeff[16];
+                for(int y=0;y<4;++y)for(int x=0;x<4;++x){
+                    short v=test<1024?(short)((int)(random32()%2048)-1024):(short)(random32()>>16);
+                    coeff[y*4+x]=atlas[(by+y)*side+bx+x]=v;
+                }
+                oracle_idct4(expected[p]+by*32+bx,coeff,32);
+            }
+        }
+        XenonH264Backend backend={};backend.execute=fail_after_write;
+        xenon_h264_bridge_init(&bridge,test&1?&backend:NULL);bridge.jobs[0]=j;bridge.count=1;
+        xenon_h264_bridge_flush(&bridge);xenon_h264_bridge_flush(&bridge);
+        if(bridge.count||bridge.cpu_jobs!=1||bridge.gpu_jobs||bridge.batches!=1||bridge.backend_failures!=(unsigned)(test&1))return 2;
+        if(memcmp(actual,expected,sizeof(actual))){fprintf(stderr,"FAIL replay case %d motion %d,%d\n",test,j.mv_x,j.mv_y);return 1;}
+        checked+=384;
+    }
+    printf("PASS: %llu exact CPU replay pixels, negative motion, padded strides, int16 extremes, partial-backend-failure replay (host only)\n",checked);
+    return 0;
+}
