@@ -0,0 +1,84 @@
+#include "hybrid_jobs.h"
+#include <string.h>
+
+namespace {
+int clip(int n){return n<0?0:n>255?255:n;}
+int floor_div(int n,int d){return n>=0?n/d:-((-n+d-1)/d);}
+int pixel(const uint8_t* p,int stride,int w,int h,int x,int y){
+    x=x<0?0:x>=w?w-1:x;y=y<0?0:y>=h?h-1:y;return p[y*stride+x];
+}
+int filter(const uint8_t* p,int stride,int w,int h,int x,int y,int dx,int dy){
+    static const int taps[6]={1,-5,20,20,-5,1};int sum=0;
+    for(int i=0;i<6;++i)sum+=taps[i]*pixel(p,stride,w,h,x+(i-2)*dx,y+(i-2)*dy);
+    return sum;
+}
+int luma(const uint8_t* p,int stride,int w,int h,int x,int y,int fx,int fy){
+    int a=pixel(p,stride,w,h,x,y);
+    if(!fx&&!fy)return a;
+    int horizontal=clip(floor_div(filter(p,stride,w,h,x,y,1,0)+16,32));
+    int vertical=clip(floor_div(filter(p,stride,w,h,x,y,0,1)+16,32));
+    if(!fy)return fx==2?horizontal:(horizontal+pixel(p,stride,w,h,x+(fx==3),y)+1)/2;
+    if(!fx)return fy==2?vertical:(vertical+pixel(p,stride,w,h,x,y+(fy==3))+1)/2;
+    if((fx&1)&&(fy&1)){
+        int hh=clip(floor_div(filter(p,stride,w,h,x,y+(fy==3),1,0)+16,32));
+        int vv=clip(floor_div(filter(p,stride,w,h,x+(fx==3),y,0,1)+16,32));
+        return(hh+vv+1)/2;
+    }
+    static const int taps[6]={1,-5,20,20,-5,1};int diagonal=0;
+    for(int i=0;i<6;++i)diagonal+=taps[i]*filter(p,stride,w,h,x,y+i-2,1,0);
+    diagonal=clip(floor_div(diagonal+512,1024));
+    if(fx==2&&fy==2)return diagonal;
+    if(fx==2){int hh=clip(floor_div(filter(p,stride,w,h,x,y+(fy==3),1,0)+16,32));return(diagonal+hh+1)/2;}
+    int vv=clip(floor_div(filter(p,stride,w,h,x+(fx==3),y,0,1)+16,32));return(diagonal+vv+1)/2;
+}
+void transform(const int c[4],int v[4]){
+    int even0=c[0]+c[2],even1=c[0]-c[2];
+    int odd0=floor_div(c[1],2)-c[3],odd1=c[1]+floor_div(c[3],2);
+    v[0]=even0+odd1;v[1]=even1+odd0;v[2]=even1-odd0;v[3]=even0-odd1;
+}
+void residual4(const int16_t* src,int pitch,int result[16]){
+    int16_t intermediate[16];
+    for(int x=0;x<4;++x){int c[4],v[4];for(int y=0;y<4;++y)c[y]=src[y*pitch+x];
+        if(!x)c[0]=(int16_t)(c[0]+32);
+        transform(c,v);for(int y=0;y<4;++y)intermediate[y*4+x]=(int16_t)v[y];
+    }
+    for(int x=0;x<4;++x){int c[4],v[4];for(int y=0;y<4;++y)c[y]=intermediate[x*4+y];
+        transform(c,v);for(int y=0;y<4;++y)result[y*4+x]=floor_div(v[y],64);
+    }
+}
+}
+extern "C" void xenon_h264_reconstruct_cpu(const XenonH264Job* j){
+    for(int plane=0;plane<3;++plane){
+        const int side=plane?8:16,w=plane?j->width/2:j->width,h=plane?j->height/2:j->height;
+        const int divisor=plane?8:4,dx=floor_div(j->mv_x,divisor),dy=floor_div(j->mv_y,divisor);
+        const int fx=j->mv_x-dx*divisor,fy=j->mv_y-dy*divisor;
+        const int16_t* coeff=j->coefficients+(plane?256+(plane-1)*64:0);
+        for(int by=0;by<side;by+=4)for(int bx=0;bx<side;bx+=4){int residual[16];
+            residual4(coeff+by*side+bx,side,residual);
+            for(int y=0;y<4;++y)for(int x=0;x<4;++x){
+                int sx=j->mb_x*side+bx+x+dx,sy=j->mb_y*side+by+y+dy,pred;
+                const uint8_t* ref=j->reference[plane];int stride=j->reference_stride[plane];
+                if(!plane)pred=luma(ref,stride,w,h,sx,sy,fx,fy);
+                else pred=((8-fx)*(8-fy)*pixel(ref,stride,w,h,sx,sy)+fx*(8-fy)*pixel(ref,stride,w,h,sx+1,sy)+
+                           (8-fx)*fy*pixel(ref,stride,w,h,sx,sy+1)+fx*fy*pixel(ref,stride,w,h,sx+1,sy+1)+32)/64;
+                j->destination[plane][(by+y)*j->destination_stride[plane]+bx+x]=(uint8_t)clip(pred+residual[y*4+x]);
+            }
+        }
+    }
+}
+extern "C" void xenon_h264_bridge_init(XenonH264Bridge* bridge,const XenonH264Backend* backend){
+    memset(bridge,0,sizeof(*bridge));bridge->magic=0x58483236;
+    if(backend)bridge->backend=*backend;
+}
+extern "C" void xenon_h264_bridge_flush(XenonH264Bridge* bridge){
+    if(!bridge||bridge->magic!=0x58483236||!bridge->count)return;
+    unsigned count=bridge->count;int success=0;++bridge->batches;
+    if(bridge->backend.execute)success=bridge->backend.execute(bridge->backend.opaque,bridge->jobs,count);
+    if(success)bridge->gpu_jobs+=count;
+    else{
+        if(bridge->backend.execute)++bridge->backend_failures;
+        for(unsigned i=0;i<count;++i)xenon_h264_reconstruct_cpu(&bridge->jobs[i]);
+        bridge->cpu_jobs+=count;
+    }
+    bridge->count=0;
+}
