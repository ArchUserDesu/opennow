+#ifndef OPENNOW_HYBRID_JOBS_H
+#define OPENNOW_HYBRID_JOBS_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* The first backend accelerates progressive, unweighted list-0 16x16 inter
+ * macroblocks with 4x4 transforms. Other syntax remains FFmpeg CPU work.
+ * Jobs never outlive a reconstruction barrier (intra, row/filter, slice/error).
+ * CPU reference pictures remain authoritative, making fallback lossless. */
+enum { XENON_H264_BATCH_MAX=80, XENON_H264_WIDTH_MAX=1280 };
+typedef struct XenonH264Job {
+    const uint8_t* reference[3];
+    int reference_stride[3];
+    uint8_t* destination[3];
+    int destination_stride[3];
+    int width,height,mb_x,mb_y,mv_x,mv_y;
+    /* Raster planes of FFmpeg-layout transposed 4x4 dequantized blocks.
+       Chroma DC inverse-transform/dequantization has already been done. */
+    int16_t coefficients[384];
+} XenonH264Job;
+
+typedef struct XenonH264Backend {
+    void* opaque;
+    /* Must finish every job before returning. Zero means no valid output:
+       the bridge reconstructs ALL submitted jobs on CPU in that case. */
+    int (*execute)(void*,const XenonH264Job*,unsigned);
+    /* Invalidate uploaded references whenever a new picture starts. */
+    void (*begin_picture)(void*,int);
+} XenonH264Backend;
+
+typedef struct XenonH264Bridge {
+    uint32_t magic;
+    XenonH264Backend backend;
+    XenonH264Job jobs[XENON_H264_BATCH_MAX];
+    unsigned count;
+    int picture_number,have_picture;
+    uint64_t gpu_jobs,cpu_jobs,batches,backend_failures;
+} XenonH264Bridge;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void xenon_h264_bridge_init(XenonH264Bridge*,const XenonH264Backend*);
+void xenon_h264_bridge_flush(XenonH264Bridge*);
+void xenon_h264_reconstruct_cpu(const XenonH264Job*);
+/* Attach bridge using AVCodecContext.opaque only on a single-threaded
+ * experimental decoder. Do not reuse that opaque slot for another callback. */
+#ifdef __cplusplus
+}
+#endif
+#endif
