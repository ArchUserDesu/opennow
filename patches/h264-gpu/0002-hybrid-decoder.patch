+#pragma once
+#include <xtl.h>
+#include <d3d9.h>
+#include "hybrid_jobs.h"
+
+/* Standalone decoder/device owner only. Production presentation concurrency
+ * must be integrated and profiled before sharing this device with the app. */
+class XenonGpuReconstructor {
+public:
+    explicit XenonGpuReconstructor(IDirect3DDevice9*);
+    ~XenonGpuReconstructor();
+    bool initialize(const char* shader_directory);
+    XenonH264Backend callbacks();
+    uint64_t elapsed_ticks,upload_ticks,readback_ticks,successful_batches;
+private:
+    XenonGpuReconstructor(const XenonGpuReconstructor&);
+    XenonGpuReconstructor& operator=(const XenonGpuReconstructor&);
+    struct Reference {
+        const uint8_t* identity;
+        int width,height,stride;
+        IDirect3DTexture9* texture;
+        Reference():identity(NULL),width(0),height(0),stride(0),texture(NULL){}
+    } refs_[16];
+    IDirect3DDevice9* device_;
+    IDirect3DVertexShader9* vertex_;
+    IDirect3DVertexDeclaration9* declaration_;
+    IDirect3DPixelShader9* columns_,*rows_,*luma_,*chroma_;
+    IDirect3DTexture9* coefficients_,*intermediate_,*residual_,*output_;
+    IDirect3DSurface9* target_;
+    unsigned reference_cursor_;
+    bool ready_;
+    static int execute_callback(void*,const XenonH264Job*,unsigned);
+    static void begin_callback(void*,int);
+    bool execute(const XenonH264Job*,unsigned);
+    IDirect3DTexture9* reference(const XenonH264Job&,int);
+    bool draw(IDirect3DPixelShader9*,const void*,unsigned,IDirect3DTexture9*);
+    void invalidate_references();
+};
diff --git a/experiments/h264_gpu/xdk_validate.cpp b/experiments/h264_gpu/xdk_validate.cpp
new file mode 100644
index 0000000..e2352c5
--- /dev/null
+++ b/experiments/h264_gpu/xdk_validate.cpp
@@ -0,0 +1,95 @@
+// Standalone CPU-vs-hybrid decoder comparison. Never launches the OpenNOW app.
+#define __STDC_CONSTANT_MACROS
+#include <xtl.h>
+#include <d3d9.h>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include "xdk_backend.h"
+extern "C" {
+#include "libavcodec/avcodec.h"
+#include "libavutil/mem.h"
+extern AVCodec ff_h264_decoder;
+extern AVCodecParser ff_h264_parser;
+}
+
+namespace {
+FILE* log_file=NULL;
+uint64_t tick(){LARGE_INTEGER t;QueryPerformanceCounter(&t);return(uint64_t)t.QuadPart;}
+bool same_frame(const AVFrame* a,const AVFrame* b){
+    if(a->width!=b->width||a->height!=b->height||a->format!=b->format)return false;
+    if(a->format!=AV_PIX_FMT_YUV420P&&a->format!=AV_PIX_FMT_YUVJ420P)return false;
+    for(int plane=0;plane<3;++plane){int w=plane?(a->width+1)/2:a->width,h=plane?(a->height+1)/2:a->height;
+        for(int y=0;y<h;++y)if(memcmp(a->data[plane]+y*a->linesize[plane],b->data[plane]+y*b->linesize[plane],w))return false;
+    }return true;
+}
+AVCodecContext* decoder(XenonH264Bridge* bridge){
+    AVCodecContext* c=avcodec_alloc_context3(&ff_h264_decoder);if(!c)return NULL;
+    c->thread_count=1;c->thread_type=0;c->skip_loop_filter=AVDISCARD_DEFAULT;c->opaque=bridge;
+    if(avcodec_open2(c,&ff_h264_decoder,NULL)<0){av_free(c);return NULL;}return c;
+}
+bool packet(AVCodecContext* cpu,AVCodecContext* gpu,AVFrame* a,AVFrame* b,uint8_t* data,int size,
+            unsigned& frames,uint64_t& cpu_ticks,uint64_t& gpu_ticks){
+    AVPacket p;av_init_packet(&p);p.data=data;p.size=size;int have_a=0,have_b=0;
+    uint64_t begin=tick();int rc_a=avcodec_decode_video2(cpu,a,&have_a,&p);cpu_ticks+=tick()-begin;
+    begin=tick();int rc_b=avcodec_decode_video2(gpu,b,&have_b,&p);gpu_ticks+=tick()-begin;
+    if(rc_a<0||rc_b<0||have_a!=have_b){fprintf(log_file,"FAIL decode cpu=%d gpu=%d output=%d/%d\n",rc_a,rc_b,have_a,have_b);return false;}
+    if(have_a){++frames;if(!same_frame(a,b)){fprintf(log_file,"FAIL pixels frame=%u\n",frames);return false;}}
+    return true;
+}
+}
+int main(){
+    log_file=fopen("game:\\gpu-validation.log","wb");if(!log_file)return 1;
+    fprintf(log_file,"GPU H264 standalone validation; full CPU intra/deblocking, bounded GPU inter batches\n");fflush(log_file);
+    IDirect3D9* api=Direct3DCreate9(D3D_SDK_VERSION);IDirect3DDevice9* device=NULL;
+    D3DPRESENT_PARAMETERS pp;memset(&pp,0,sizeof(pp));pp.BackBufferWidth=1280;pp.BackBufferHeight=720;
+    pp.BackBufferFormat=D3DFMT_A8R8G8B8;pp.FrontBufferFormat=D3DFMT_LE_X8R8G8B8;
+    pp.BackBufferCount=1;pp.MultiSampleType=D3DMULTISAMPLE_NONE;pp.SwapEffect=D3DSWAPEFFECT_DISCARD;pp.PresentationInterval=D3DPRESENT_INTERVAL_IMMEDIATE;
+    if(!api||FAILED(api->CreateDevice(0,D3DDEVTYPE_HAL,NULL,D3DCREATE_HARDWARE_VERTEXPROCESSING,&pp,&device))){fprintf(log_file,"FAIL device\n");fclose(log_file);if(api)api->Release();return 1;}
+    int result=1;
+    {
+        XenonGpuReconstructor backend(device);
+        if(!backend.initialize("game:")){fprintf(log_file,"FAIL shader/texture/target initialization\n");}
+        else {
+            FILE* file=fopen("game:\\gpu-fixture.h264","rb");
+            if(!file)fprintf(log_file,"FAIL missing gpu-fixture.h264\n");
+            else{
+                fseek(file,0,SEEK_END);long length=ftell(file);rewind(file);
+                if(length<=0||length>16*1024*1024)fprintf(log_file,"FAIL fixture size outside 1..16MiB\n");
+                else{
+                    std::vector<uint8_t> input(length+FF_INPUT_BUFFER_PADDING_SIZE,0);
+                    bool ok=fread(&input[0],1,length,file)==(size_t)length;
+                    avcodec_register(&ff_h264_decoder);av_register_codec_parser(&ff_h264_parser);
+                    XenonH264Backend callbacks=backend.callbacks();
+                    XenonH264Bridge* bridge=new XenonH264Bridge;xenon_h264_bridge_init(bridge,&callbacks);
+                    AVCodecContext* cpu=decoder(NULL),*gpu=decoder(bridge);
+                    AVCodecParserContext* parser=av_parser_init(AV_CODEC_ID_H264);
+                    AVFrame* a=avcodec_alloc_frame(),*b=avcodec_alloc_frame();
+                    unsigned frames=0;uint64_t cpu_ticks=0,gpu_ticks=0;
+                    ok=ok&&cpu&&gpu&&parser&&a&&b;
+                    int offset=0;
+                    while(ok&&offset<length){uint8_t* data=NULL;int size=0;
+                        int consumed=av_parser_parse2(parser,cpu,&data,&size,&input[0]+offset,length-offset,AV_NOPTS_VALUE,AV_NOPTS_VALUE,offset);
+                        if(consumed<0||(!consumed&&!size)){ok=false;break;}
+                        offset+=consumed;
+                        if(size){std::vector<uint8_t> padded(size+FF_INPUT_BUFFER_PADDING_SIZE,0);memcpy(&padded[0],data,size);
+                            ok=packet(cpu,gpu,a,b,&padded[0],size,frames,cpu_ticks,gpu_ticks);}
+                    }
+                    if(ok){uint8_t* data=NULL;int size=0;av_parser_parse2(parser,cpu,&data,&size,NULL,0,AV_NOPTS_VALUE,AV_NOPTS_VALUE,offset);
+                        if(size){std::vector<uint8_t> padded(size+FF_INPUT_BUFFER_PADDING_SIZE,0);memcpy(&padded[0],data,size);ok=packet(cpu,gpu,a,b,&padded[0],size,frames,cpu_ticks,gpu_ticks);}}
+                    for(int i=0;ok&&i<16;++i){unsigned before=frames;ok=packet(cpu,gpu,a,b,NULL,0,frames,cpu_ticks,gpu_ticks);if(frames==before)break;}
+                    xenon_h264_bridge_flush(bridge);
+                    LARGE_INTEGER frequency;QueryPerformanceFrequency(&frequency);
+                    fprintf(log_file,"frames=%u cpu_ticks=%llu hybrid_ticks=%llu frequency=%llu gpu_jobs=%llu cpu_replay=%llu batches=%llu backend_failures=%llu upload_ticks=%llu readback_ticks=%llu\n",
+                        frames,cpu_ticks,gpu_ticks,(uint64_t)frequency.QuadPart,bridge->gpu_jobs,bridge->cpu_jobs,bridge->batches,bridge->backend_failures,backend.upload_ticks,backend.readback_ticks);
+                    if(ok&&frames&&bridge->gpu_jobs&&!bridge->backend_failures){fprintf(log_file,"PASS exact visible YUV frames; inspect timing separately\n");result=0;}
+                    else fprintf(log_file,"FAIL comparison, empty fixture, or GPU work not successfully exercised\n");
+                    if(parser)av_parser_close(parser);av_free(a);av_free(b);
+                    if(cpu){avcodec_close(cpu);av_free(cpu);}if(gpu){avcodec_close(gpu);av_free(gpu);}delete bridge;
+                }
+                fclose(file);
+            }
+        }
+    }
+    device->Release();api->Release();fclose(log_file);return result;
+}
