+      {0,16,D3DDECLTYPE_FLOAT2,D3DDECLMETHOD_DEFAULT,D3DDECLUSAGE_TEXCOORD,0},
+      {0,24,D3DDECLTYPE_FLOAT4,D3DDECLMETHOD_DEFAULT,D3DDECLUSAGE_TEXCOORD,1},D3DDECL_END()};
+    if(FAILED(device_->CreateVertexDeclaration(decl,&declaration_)))return false;
+    IDirect3DTexture9** textures[]={&coefficients_,&intermediate_,&residual_,&output_};
+    for(int i=0;i<4;++i)if(FAILED(device_->CreateTexture(1280,16,1,0,D3DFMT_LIN_R32F,D3DPOOL_DEFAULT,textures[i],NULL)))return false;
+    if(FAILED(device_->CreateRenderTarget(1280,16,D3DFMT_R32F,D3DMULTISAMPLE_NONE,0,FALSE,&target_,NULL)))return false;
+    ready_=true;return true;
+}
+XenonH264Backend XenonGpuReconstructor::callbacks(){XenonH264Backend b;b.opaque=this;b.execute=&execute_callback;b.begin_picture=&begin_callback;return b;}
+int XenonGpuReconstructor::execute_callback(void* p,const XenonH264Job* j,unsigned n){return ((XenonGpuReconstructor*)p)->execute(j,n)?1:0;}
+void XenonGpuReconstructor::begin_callback(void* p,int){((XenonGpuReconstructor*)p)->invalidate_references();}
+void XenonGpuReconstructor::invalidate_references(){for(int i=0;i<16;++i)refs_[i].identity=NULL;}
+IDirect3DTexture9* XenonGpuReconstructor::reference(const XenonH264Job& j,int plane){
+    const int w=plane?j.width/2:j.width,h=plane?j.height/2:j.height;
+    for(int i=0;i<16;++i)if(refs_[i].identity==j.reference[plane]&&refs_[i].width==w&&refs_[i].height==h&&refs_[i].stride==j.reference_stride[plane])return refs_[i].texture;
+    Reference& r=refs_[reference_cursor_++%16];
+    r.identity=NULL;
+    if(r.width!=w||r.height!=h){release(r.texture);r.width=w;r.height=h;}
+    if(!r.texture&&FAILED(device_->CreateTexture(w,h,1,0,D3DFMT_LIN_L8,D3DPOOL_DEFAULT,&r.texture,NULL)))return NULL;
+    uint64_t begin=ticks();D3DLOCKED_RECT lock;
+    if(FAILED(r.texture->LockRect(0,&lock,NULL,0)))return NULL;
+    for(int y=0;y<h;++y)memcpy((uint8_t*)lock.pBits+y*lock.Pitch,j.reference[plane]+y*j.reference_stride[plane],w);
+    r.texture->UnlockRect(0);upload_ticks+=ticks()-begin;r.identity=j.reference[plane];r.stride=j.reference_stride[plane];return r.texture;
+}
+bool XenonGpuReconstructor::draw(IDirect3DPixelShader9* shader,const void* vertices,unsigned vertex_count,IDirect3DTexture9* destination){
+    device_->SetPixelShader(shader);
+    HRESULT hr=device_->DrawPrimitiveUP(D3DPT_TRIANGLELIST,vertex_count/3,vertices,sizeof(Vertex));
+    if(FAILED(hr))return false;
+    if(destination)device_->Resolve(D3DRESOLVE_RENDERTARGET0,NULL,destination,NULL,0,0,NULL,1,0,NULL);
+    return true;
+}
+bool XenonGpuReconstructor::execute(const XenonH264Job* jobs,unsigned count){
+    if(!ready_||!jobs||!count||count>XENON_H264_BATCH_MAX)return false;
+    for(unsigned i=0;i<count;++i){const XenonH264Job& j=jobs[i];
+        if(j.width<=0||j.height<=0||j.width>1280||j.height>720||j.width%16||j.height%16)return false;
+        for(int p=0;p<3;++p)if(!j.reference[p]||!j.destination[p]||j.reference_stride[p]<(p?j.width/2:j.width)||j.destination_stride[p]<(p?8:16))return false;
+    }
+    const uint64_t begin=ticks();RestoreTarget restore(device_);Scene scene(device_);
+    device_->SetRenderTarget(0,target_);device_->SetDepthStencilSurface(NULL);
+    D3DVIEWPORT9 vp={0,0,1280,16,0,1};device_->SetViewport(&vp);
+    device_->SetVertexDeclaration(declaration_);device_->SetVertexShader(vertex_);
+    device_->SetRenderState(D3DRS_ZENABLE,FALSE);device_->SetRenderState(D3DRS_ALPHABLENDENABLE,FALSE);
+    device_->SetRenderState(D3DRS_ALPHATESTENABLE,FALSE);device_->SetRenderState(D3DRS_CULLMODE,D3DCULL_NONE);
+    device_->SetRenderState(D3DRS_SCISSORTESTENABLE,FALSE);
+    // Use native half-integer pixel centers, matching floor(uv * atlasSize).
+    device_->SetRenderState(D3DRS_HALFPIXELOFFSET,FALSE);
+    device_->SetRenderState(D3DRS_COLORWRITEENABLE,0xf);
+    for(unsigned s=0;s<3;++s){device_->SetSamplerState(s,D3DSAMP_MINFILTER,D3DTEXF_POINT);device_->SetSamplerState(s,D3DSAMP_MAGFILTER,D3DTEXF_POINT);
+        device_->SetSamplerState(s,D3DSAMP_MIPFILTER,D3DTEXF_NONE);device_->SetSamplerState(s,D3DSAMP_ADDRESSU,D3DTADDRESS_CLAMP);device_->SetSamplerState(s,D3DSAMP_ADDRESSV,D3DTADDRESS_CLAMP);
+    }
+    float params[16]={1280,720,1280,16};device_->SetPixelShaderConstantF(0,params,4);
+    Vertex full[6];quad(full,0,0,1,1,0,0);
+    for(int plane=0;plane<3;++plane){
+        const int side=plane?8:16;
+        D3DLOCKED_RECT lock;uint64_t start=ticks();
+        if(FAILED(coefficients_->LockRect(0,&lock,NULL,0)))return false;
+        for(int y=0;y<16;++y)memset((uint8_t*)lock.pBits+y*lock.Pitch,0,1280*sizeof(float));
+        for(unsigned i=0;i<count;++i){const int16_t* src=jobs[i].coefficients+(plane?256+(plane-1)*64:0);
+            for(int y=0;y<side;++y){float* row=(float*)((uint8_t*)lock.pBits+y*lock.Pitch)+i*side;
+                for(int x=0;x<side;++x)row[x]=(float)src[y*side+x];}}
+        coefficients_->UnlockRect(0);upload_ticks+=ticks()-start;
+        device_->SetTexture(0,NULL);device_->SetTexture(2,coefficients_);
+        if(!draw(columns_,full,6,intermediate_))return false;
+        device_->SetTexture(2,intermediate_);
+        if(!draw(rows_,full,6,residual_))return false;
+        device_->SetTexture(2,residual_);
+        // Group independent output quads by reference; one draw per group.
+        bool done[XENON_H264_BATCH_MAX]={};
+        for(unsigned first=0;first<count;++first){if(done[first])continue;
+            IDirect3DTexture9* ref=reference(jobs[first],plane);if(!ref)return false;
+            params[0]=(float)(plane?jobs[first].width/2:jobs[first].width);params[1]=(float)(plane?jobs[first].height/2:jobs[first].height);
+            device_->SetPixelShaderConstantF(0,params,4);device_->SetTexture(0,ref);
+            Vertex vertices[XENON_H264_BATCH_MAX*6];unsigned n=0;
+            for(unsigned i=first;i<count;++i){if(done[i]||jobs[i].reference[plane]!=jobs[first].reference[plane])continue;
+                if(jobs[i].width!=jobs[first].width||jobs[i].height!=jobs[first].height||jobs[i].reference_stride[plane]!=jobs[first].reference_stride[plane])return false;
+                const int units=plane?8:4;
+                float mx=(float)(jobs[i].mv_x+(jobs[i].mb_x-(int)i)*side*units);
+                float my=(float)(jobs[i].mv_y+jobs[i].mb_y*side*units);
+                quad(vertices+n,(float)(i*side)/1280,0,(float)((i+1)*side)/1280,(float)side/16,mx,my);n+=6;done[i]=true;
+            }
+            if(!draw(plane?chroma_:luma_,vertices,n,NULL))return false;
+        }
+        device_->SetTexture(0,NULL);device_->SetTexture(2,NULL);
+        device_->Resolve(D3DRESOLVE_RENDERTARGET0,NULL,output_,NULL,0,0,NULL,1,0,NULL);
+        start=ticks();
+        if(FAILED(output_->LockRect(0,&lock,NULL,D3DLOCK_READONLY)))return false;
+        bool valid=true;
+        for(unsigned i=0;i<count;++i)for(int y=0;y<side;++y){const float* row=(const float*)((const uint8_t*)lock.pBits+y*lock.Pitch)+i*side;
+            uint8_t* dst=jobs[i].destination[plane]+y*jobs[i].destination_stride[plane];
+            for(int x=0;x<side;++x){const float v=row[x];if(!(v>=0&&v<=255)||(float)(int)v!=v){valid=false;break;}dst[x]=(uint8_t)v;}}
+        output_->UnlockRect(0);readback_ticks+=ticks()-start;
+        if(!valid){ready_=false;return false;}
+    }
+    elapsed_ticks+=ticks()-begin;++successful_batches;return true;
+}
diff --git a/experiments/h264_gpu/xdk_backend.h b/experiments/h264_gpu/xdk_backend.h
new file mode 100644
